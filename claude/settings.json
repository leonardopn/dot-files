{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "auto",
  "autoCompactEnabled": false,
  "idleCompaction": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "spinnerTipsEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(~/.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "900000",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "caveman-auto[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Auto",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Caveman pick model + effort each turn. Hard ask, big brain. Easy ask, save rocks.",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES": "effort,max_effort,xhigh_effort,thinking,adaptive_thinking,interleaved_thinking"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node' '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/caveman' shrink-hook",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/leonardopn/.local/share/caveman-blocks/bin/caveman-blocks hook --harness claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/leonardopn/.caveman/bin/caveman-proxy' native-hook claude --adapter '/home/leonardopn/.nvm/versions/node/v24.12.0/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/home/leonardopn/.nvm/versions/node/v24.12.0/bin/node'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
